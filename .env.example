# anthropic | openai | gemini | ollama
LLM_PROVIDER=ollama

# not needed for ollama
LLM_API_KEY=

# chat model name for the selected provider
CHAT_MODEL=llama3.1

# embedding model name (openai/gemini use their own embeddings API; anthropic
# has none, so embeddings fall back to ollama even when LLM_PROVIDER=anthropic)
EMBEDDING_MODEL=nomic-embed-text

# only used when embeddings or chat go through ollama
OLLAMA_URL=http://localhost:11434

# only used by `npm run eval`: pause this many ms between cases, useful to
# stay under a free-tier rate limit (e.g. Gemini). Default 0 (no pause).
EVAL_DELAY_MS=0

# --- Gemini free tier example (Google AI Studio API key) ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-google-ai-studio-key
# CHAT_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# EVAL_DELAY_MS=2000
