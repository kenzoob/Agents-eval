# anthropic | openai | ollama
LLM_PROVIDER=ollama

# not needed for ollama
LLM_API_KEY=

# chat model name for the selected provider
CHAT_MODEL=llama3.1

# embedding model name (openai uses its own embeddings API; anthropic has
# none, so embeddings fall back to ollama even when LLM_PROVIDER=anthropic)
EMBEDDING_MODEL=nomic-embed-text

# only used when embeddings or chat go through ollama
OLLAMA_URL=http://localhost:11434
